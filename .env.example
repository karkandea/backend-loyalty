# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Existing PostgreSQL / later VPS PostgreSQL
ConnectionStrings__LoyaltyDb=Host=localhost;Port=5432;Database=loyalty;Username=loyalty_app;Password=change-me

# Existing Supabase Auth issuer (keep auth migration separate for now)
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co

# React frontend origins (use indexed config keys for arrays)
Cors__AllowedOrigins__0=http://localhost:5173
