# Server-only VPS configuration.
# scripts/migrate-supabase-to-vps.sh generates real random values in .env.vps.
ASPNETCORE_ENVIRONMENT=Production

# Dedicated PostgreSQL 17 container. Neither password belongs in frontend code.
LOYALTY_DB_ADMIN_PASSWORD=replace-with-random-admin-secret
LOYALTY_DB_PASSWORD=replace-with-random-app-secret

# Local-only API port; place Nginx/reverse proxy in front when exposing the service.
LOYALTY_API_PORT=5092

# Loyalty-owned JWT. Use a random secret of at least 32 bytes; keep it server-only.
Jwt__Issuer=backend-loyalty
Jwt__Audience=loyalty-app
Jwt__SigningKey=replace-with-a-long-random-server-secret-at-least-32-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# React frontend origins (use indexed config keys for arrays)
Cors__AllowedOrigins__0=http://localhost:5173

# docker-compose.vps.yml injects this automatically into the API container:
# ConnectionStrings__LoyaltyDb=Host=loyalty-postgres;Port=5432;Database=loyalty;Username=loyalty_app;Password=<LOYALTY_DB_PASSWORD>
